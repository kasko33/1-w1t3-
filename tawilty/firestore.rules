rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCashier() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cashier';
    }

    // كل مستخدم يقرأ ملفه فقط، والأدوار تُضبط من لوحة Firebase
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // الطاولات: الويتر يحجز ويضيف أصنافاً ويفرّغ، والكاشير وحده يضيف/يحذف طاولات
    match /tables/{id} {
      allow read: if signedIn();
      allow update: if signedIn();
      allow create, delete: if isCashier();
    }

    // الإحصائيات: الكاشير يقرأ، وأي موظف مسجّل يرحّل جلسة عند التفريغ
    match /daily_stats/{date} {
      allow read: if isCashier();
      allow create, update: if signedIn();
      allow delete: if false;
    }
  }
}
